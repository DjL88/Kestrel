rules_version = '2';

// InFlight keeps all of its Firestore data on the server side. The control plane reads and writes it with its own
// service account, through the Admin SDK, which these rules do not restrict. No app, browser, gallery page or client
// SDK reads Firestore directly, so nothing is readable or writable from one. That includes shared-project comments:
// a client member reaches only the comments they wrote, through the control plane (collaboration.ts), never here.
//
// Tested on the Firestore emulator: services/control-plane/test/firestore-rules.emulator.test.ts.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
