node_modules
build/
dist/
coverage/
.DS_Store
*.log

# Large optional model files, fetched by npm run model:species
public/models/bioclip-image-int8.onnx
# The bundled models and species lists, fetched by npm run models:fetch (models/bundled-models.json)
public/models/clip-vit-b32-vision-uint8.onnx
public/models/dinov2-small-fp16.onnx
public/models/species-world.json
public/models/species-mammals.json
public/models/species-reptiles.json
public/models/species-amphibians.json
public/models/species-odonata.json
public/models/species-lepidoptera.json
.env*
!.env.example

# Playwright run output
/test-results/
/playwright-report/
/src-tauri/target/
/src-tauri/gen/schemas/
raw-samples/
.venv/
tools/denoise-training/.venv/
# Python virtual environment for tools/ (training, Lightroom reader)
__pycache__/
tools/subject-router/.venv/
tools/subject-router/models/

# Local Auto comparisons of the owner's own photos (npm run compare:auto). Never commit.
kestrel-auto-compare/
# Local journey runs on the owner's own photos (npm run journey:local). Never commit.
kestrel-journey-out/
/crates/*/target/

# Terraform working files (state lives in the GCS state bucket; never commit it)
infra/gcp/.terraform/
infra/gcp/*.tfstate
infra/gcp/*.tfstate.*
infra/gcp/*.tfvars
.firebase/

# Local prototype evidence may include filenames or test output; keep it private.
.kestrel-prototype-evidence/
prototype-evidence.json

# Firebase config files are per-developer build inputs, not source.
GoogleService-Info.plist
google-services.json
# Apple and other signing material never belongs in the repository (keys stay in the keychain or a password manager).
*.p8
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
AuthKey_*
