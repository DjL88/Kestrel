{
  "name": "kestrel",
  "private": true,
  "version": "26.11.2",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/check-source-parse.mjs && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "model:species": "node scripts/fetch-species-model.mjs",
    "lint": "node scripts/check-source-parse.mjs && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:raw-master": "node scripts/test-raw-master.mjs",
    "test:e2e:dev": "playwright test -c playwright.dev.config.ts",
    "test": "node --import tsx --test \"src/core/*.test.ts\" \"src/engine/*.test.ts\" \"src/v2/*.test.ts\" \"src/v2/ui/utils/*.test.ts\" \"src/v2/engineClient/*.test.ts\" \"src/providers/*.test.ts\" \"tools/mcp/*.test.ts\" \"services/control-plane/test/*.test.ts\" \"services/cloud-runner/test/*.test.ts\" \"scripts/prototype-gate.test.mjs\" \"scripts/check-source-parse.test.mjs\" \"scripts/site/verify-deployment.test.mjs\" \"scripts/site/admin-flags.test.mjs\"",
    "control-plane": "npm --prefix services/control-plane start",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/build-desktop.mjs",
    "mcp": "tsx tools/mcp/kestrel-mcp.ts",
    "compare:auto": "tsx scripts/natural-auto-compare.ts",
    "journey:local": "tsx scripts/journey-local.ts",
    "raw:wasm": "node scripts/build-raw-wasm.mjs",
    "build:site-editor": "vite build --config vite.demo.config.ts",
    "verify:site-editor": "node scripts/site/verify-deployment.mjs",
    "check:syntax": "node scripts/check-source-parse.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@vitejs/plugin-react": "^6.1.1",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "firebase": "^13.4.0",
    "libheif-js": "1.23.5",
    "lottie-web": "5.12.2",
    "lucide-react": "^1.73.0",
    "onnxruntime-web": "^1.31.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
