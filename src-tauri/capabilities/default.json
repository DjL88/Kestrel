{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Window access for explicit file operations and HTTPS BYO services; plain HTTP is limited to local loopback, never arbitrary internet or LAN hosts.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-seek",
    "fs:allow-read",
    "fs:allow-open",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-appdata-meta-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-read-recursive",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "https://*:*"
        },
        {
          "url": "http://localhost:*"
        },
        {
          "url": "http://127.0.0.1:*"
        },
        {
          "url": "http://[::1]:*"
        }
      ]
    }
  ]
}
