{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop only: reveal a saved export, open an official published Kestrel release page, and guard signed updates.",
  "windows": [
    "main"
  ],
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "permissions": [
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/DjL88/Kestrel/releases/tag/*"
        }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
