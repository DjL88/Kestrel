{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop only: show a saved file in Finder or Explorer, and the (currently switched off) updater.",
  "windows": [
    "main"
  ],
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "permissions": [
    "opener:allow-reveal-item-in-dir",
    "updater:default",
    "process:allow-restart"
  ]
}
