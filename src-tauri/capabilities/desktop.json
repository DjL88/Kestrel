{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop only: show a saved file in Finder or Explorer, and the (currently switched off) updater.",
  "windows": [
    "main"
  ],
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "permissions": [
    "opener:allow-reveal-item-in-dir",
    { "identifier": "opener:allow-open-url", "allow": [
      { "url": "https://inflight.studio/#pricing" },
      { "url": "https://inflight.studio/privacy.html" },
      { "url": "https://www.dropbox.com/oauth2/authorize*" },
      { "url": "https://accounts.google.com/o/oauth2/v2/auth*" },
      { "url": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize*" },
      { "url": "https://login.microsoftonline.com/organizations/oauth2/v2.0/authorize*" },
      { "url": "https://inflight.studio/pro-checkout?_ptxn=*" },
      { "url": "https://customer-portal.paddle.com/*" },
      { "url": "https://sandbox-customer-portal.paddle.com/*" },
      { "url": "https://inflight.studio/apple-signin?*" }
    ] },
    "updater:default",
    "process:allow-restart"
  ]
}
