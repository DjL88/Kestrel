{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kestrel",
  "version": "26.11.2",
  "identifier": "app.kestrel.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kestrel",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "shortDescription": "Calm photo culling and editing for wildlife photographers",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg",
          "png",
          "webp",
          "heic",
          "heif",
          "hif",
          "nef",
          "nrw",
          "arw",
          "srf",
          "sr2",
          "cr2",
          "cr3",
          "raf",
          "rw2",
          "orf",
          "pef",
          "dng"
        ],
        "name": "Photo",
        "description": "Photo or camera RAW file",
        "role": "Editor",
        "contentTypes": [
          "public.jpeg",
          "public.png",
          "org.webmproject.webp",
          "public.heic",
          "public.heif",
          "public.camera-raw-image",
          "com.adobe.raw-image",
          "com.nikon.raw-image",
          "com.nikon.nrw-raw-image",
          "com.sony.arw-raw-image",
          "com.sony.sr2-raw-image",
          "com.sony.raw-image",
          "com.canon.cr2-raw-image",
          "com.canon.cr3-raw-image",
          "com.fuji.raw-image",
          "com.panasonic.rw2-raw-image",
          "com.olympus.raw-image",
          "com.pentax.raw-image"
        ]
      }
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/installer/header.bmp",
        "uninstallerHeaderImage": "icons/installer/header.bmp",
        "sidebarImage": "icons/installer/sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2ODc1ODA5QjlFQjVDODcKUldTSFhPdTVDVmlIaHA4YTdUK1VUZ25GSVVmYklPZDZUTC9wdkM2ZmQvUVFCSjVYVE85Y3J5cmMK",
      "endpoints": [
        "https://github.com/DjL88/Kestrel/releases/latest/download/latest.json"
      ]
    }
  }
}
