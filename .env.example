# Optional. Turns on species suggestions by giving the address of the downloadable model (see docs/models.md).
# Run `npm run model:species` first so the file is in public/models/, then:
# VITE_SPECIES_MODEL_URL=/models/bioclip-image-int8.onnx

# Online licence checks (optional; build settings, not secrets). Without both, KESTREL1 keys still unlock Pro fully
# offline and the Licence screen says this version does not register devices online.
# VITE_KESTREL_CONTROL_PLANE_URL=https://kestrel-control-plane-xxxx.europe-west2.run.app
# The control plane's grant key: its id and base64 public key, printed in the service log on start.
# VITE_KESTREL_GRANT_KEYS=kcp-2026-11=BASE64PUBLICKEY
