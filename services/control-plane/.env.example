# Kestrel control plane. PLACEHOLDERS ONLY: never commit real values.
# The app works fully offline without this service.

# Local development: throwaway keys and an in-memory database. Never in production.
KCP_DEV_MODE=1
KCP_DEV_ADMIN_EMAIL=admin@example.test
KCP_DEV_ADMIN_PASSWORD=change-me-local-only

PORT=8787
# SQLite file for a single instance (a PostgreSQL adapter implements the same Store).
KCP_DATABASE_PATH=./data/control-plane.sqlite

# 32 random bytes, base64. Signs 15-minute session tokens.
KCP_SESSION_SECRET=

# Ed25519 PKCS#8 PEM that signs offline grants and the model manifest.
# Clients pin the matching public key by this id.
KCP_SIGNING_KEY_ID=
KCP_SIGNING_KEY_PEM=

# Public key (raw 32 bytes, base64) of the KESTREL1 licence signer (src/core/licence.ts).
KCP_LICENCE_PUBLIC_KEY=
# Only on the instance that issues licence keys. Leave empty elsewhere.
KCP_LICENCE_PRIVATE_KEY_PEM=

# Shared secret from the payment provider for webhook HMAC-SHA256.
KCP_WEBHOOK_SECRET=

# Server-side AI provider key. Never VITE_*, never in a client build.
KCP_GEMINI_API_KEY=
KCP_GEMINI_MODEL=gemini-2.5-flash

# Origins allowed to call from a browser or desktop webview.
KCP_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://localhost:3000
